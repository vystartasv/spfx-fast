{
  "flowPatterns": [
    { "id": "none", "name": "No flow required", "summary": "The app handles the work directly." },
    { "id": "approval", "name": "Approval", "summary": "Start approval, update the decision, and notify the requester." },
    { "id": "notify", "name": "Notification", "summary": "Notify an owner or team when a relevant item is created or changed." },
    { "id": "reminder", "name": "Due-date reminder", "summary": "Run on a schedule, find due work, and send a reminder." },
    { "id": "digest", "name": "Scheduled digest", "summary": "Group open or overdue work and send a periodic summary." },
    { "id": "file-approval", "name": "Document approval", "summary": "Approve a file, set its content status, then route it to a folder." },
