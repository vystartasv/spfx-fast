{
  "scenarios": [
    {
      "id": "equipment-request",
      "name": "Equipment requests",
      "description": "Request devices or supplies and track approval and fulfillment.",
      "automation": ["Power Automate can start an approval on item creation, update Status, and notify the requester."],
      "fields": [
        { "name": "Title", "title": "Request", "type": "text", "required": true },
        { "name": "Requester", "title": "Requester (claims login or email)", "type": "text", "required": true },
        { "name": "DeviceType", "title": "Device type", "type": "choice", "choices": ["Laptop", "Monitor", "Phone", "Other"] },
        { "name": "Justification", "title": "Business justification", "type": "multiline", "required": true },
        { "name": "EstimatedCost", "title": "Estimated cost", "type": "number" },
        { "name": "Status", "title": "Status", "type": "choice", "choices": ["Submitted", "Approved", "Rejected", "Ordered", "Fulfilled"] }
      ]
    },
    {
      "id": "leave-request",
